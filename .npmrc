# Record exact versions for newly installed packages, without a "^" range.
# Ranges are the main reason a project stops building the same way it did
# yesterday. Exact versions + package-lock.json + `npm ci` = reproducible installs.
save-exact=true

# NOTE: engine-strict is deliberately NOT enabled.
# It applies to the entire dependency tree, not just the root package, so any
# transitive dependency with a narrow "engines" field becomes a hard install
# failure. For example @napi-rs/lzma-linux-x64-gnu requires
# ^22.20 || ^24.12 || >=25 and would break installs on Linux CI.
# scripts/check-node.mjs checks only this project's Node version instead.

fund=false
