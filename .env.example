# Copy to .env and fill in the values:  cp .env.example .env

VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=

# Yandex Metrica counter id, used for A/B exposure tracking in src/ab/tracking.ts.
# Optional: when empty, Metrica reporting is simply skipped.
VITE_YM_COUNTER=
