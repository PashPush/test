{
  "name": "test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <25",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "dev": "vite",
    "start": "vite",
    "predeploy": "npm run build && echo pahov.ru > dist/CNAME",
    "deploy": "gh-pages -d dist",
    "prebuild": "node scripts/check-node.mjs --warn && node scripts/check-emailjs-env.mjs --mode production",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-bundle-budget.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "pretest:run": "node scripts/check-node.mjs --warn",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium webkit"
  },
  "dependencies": {
    "@emailjs/browser": "4.4.1",
    "@gsap/react": "2.1.2",
    "@tailwindcss/vite": "4.1.7",
    "gsap": "3.13.0",
    "i18next": "25.7.3",
    "i18next-browser-languagedetector": "8.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "16.5.1",
    "react-icons": "5.5.0",
    "react-responsive": "10.0.1",
    "tailwindcss": "4.1.7",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@playwright/test": "1.58.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.0.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/ui": "4.1.10",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.23",
    "gh-pages": "6.3.0",
    "globals": "16.4.0",
    "jsdom": "27.4.0",
    "prettier": "3.6.2",
    "rollup-plugin-visualizer": "6.0.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.46.0",
    "vite": "6.4.3",
    "vite-plugin-glsl": "1.5.4",
    "vitest": "4.1.10"
  }
}
